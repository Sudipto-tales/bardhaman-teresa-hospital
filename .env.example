# Copy to .env and fill in. .env is never committed.

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
APP_NAME="Teresa Memorial Hospital"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------
# Database
# SQLite in development, MySQL in production. Switching is
# this key and nothing else — the migrations run on both.
# ---------------------------------------------------------
DB_TYPE=sqlite

# The file path when DB_TYPE=sqlite, the database name when
# DB_TYPE=mysql. Left empty, SQLite defaults to
# database/database.sqlite.
DB_DATABASE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------
# Mail
# Enquiry notifications and job applications go out through
# this. An application mail carries the applicant's CV as an
# attachment, so the account has to be able to send them.
# ---------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Teresa Memorial Hospital"

# Where job applications land. A vacancy may override it.
CAREERS_EMAIL=careers@teresamemorial.org

# ---------------------------------------------------------
# Uploads
# ---------------------------------------------------------
UPLOAD_MAX_MB=8

# ---------------------------------------------------------
# Sessions and tokens
# Generate real values before deploying:
#     php -r "echo bin2hex(random_bytes(32));"
# ---------------------------------------------------------
APP_KEY=
JWT_SECRET=
JWT_TTL=3600

# ---------------------------------------------------------
# CORS — the panel is same-origin, so this stays closed
# unless something external needs the API.
# ---------------------------------------------------------
CORS_ORIGINS=
