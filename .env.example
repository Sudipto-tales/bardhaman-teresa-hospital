# Copy to .env and fill in. .env is never committed.

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
APP_NAME="Teresa Memorial Hospital"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata

# The URL the site is actually served at, scheme included, no trailing slash.
# base_url() is built from this, and every stylesheet, script and link on the
# page is an absolute URL built by base_url() — so an APP_URL naming a domain
# that is not serving the page gives markup that fetches its CSS from
# somewhere else, and the site renders as unstyled HTML. On a temporary
# *.hostingersite.com address that address is the value, and this line changes
# when the real domain is attached.
APP_URL=http://localhost:8000

# ---------------------------------------------------------
# Database
# SQLite in development, MySQL in production. Switching is
# this key and nothing else — the migrations run on both.
# ---------------------------------------------------------
DB_TYPE=sqlite

# The file path when DB_TYPE=sqlite, the database name when
# DB_TYPE=mysql. Left empty, SQLite defaults to
# database/database.sqlite.
#
# In production give it an absolute path OUTSIDE the document root —
# /home/uNNNNNNNNN/data/database.sqlite, not somewhere under public_html.
# The deploy checks the repo out into public_html, so a database left at
# the default sits in the served tree behind nothing but .htaccess. The
# directory has to be writable by PHP, not just the file: SQLite writes
# -wal and -shm files beside the database.
DB_DATABASE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------
# Mail
# Enquiry notifications and job applications go out through
# this. An application mail carries the applicant's CV as an
# attachment, so the account has to be able to send them.
# ---------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Teresa Memorial Hospital"

# Where job applications land. A vacancy may override it.
CAREERS_EMAIL=careers@teresamemorial.org

# ---------------------------------------------------------
# Uploads
# ---------------------------------------------------------
UPLOAD_MAX_MB=8

# Gallery video. Both of these are ceilings, not promises: PHP's own
# upload_max_filesize and post_max_size still apply, and whichever is smallest
# wins. Raise them in php.ini alongside this or a large clip is refused before
# the application ever sees it.
UPLOAD_MAX_VIDEO_MB=128

# ffmpeg, for compressing gallery video on upload. Left empty, the binaries are
# looked up on PATH; absent altogether, the clip is stored exactly as uploaded
# and the panel says so rather than refusing it.
FFMPEG_BIN=
FFPROBE_BIN=

# ---------------------------------------------------------
# Sessions and tokens
# Generate real values before deploying:
#     php -r "echo bin2hex(random_bytes(32));"
# ---------------------------------------------------------
APP_KEY=
JWT_SECRET=
JWT_TTL=3600

# ---------------------------------------------------------
# CORS — the panel is same-origin, so this stays closed
# unless something external needs the API.
# ---------------------------------------------------------
CORS_ORIGINS=
