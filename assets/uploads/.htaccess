# Uploaded media. Public by design — these are the pictures the site renders —
# but nothing in here is ever code.
#
# core/Upload.php already refuses anything that is not an image or a gallery
# video, by extension and by the file's own bytes, and stores it under a random
# name. This is the second lock: if that check is ever loosened, or a file
# arrives some other way, the server still refuses to run it.

<FilesMatch "\.(?i:php|php[0-9]|phtml|phps|phar|inc|cgi|pl|py|rb|sh|bash|exe|so)$">
    Require all denied
</FilesMatch>

# Belt and braces for hosts where FilesMatch is overridden by a handler set
# further up: strip the handlers rather than rely on the deny alone.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar

Options -ExecCGI -Indexes
