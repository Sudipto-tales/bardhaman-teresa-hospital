# Scratch renders used to eyeball the two themes side by side.
# Regenerate them whenever; they are never served.
__t_dark.html
__t_light.html

# Pre-rebuild copy of the old single-page site, kept locally for
# reference. The home page is now rendered by app/page/site/home.php.
website.original.html

# Secrets and machine-specific config. .env.example is the template.
.env

# Composer installs these; composer.json and composer.lock are committed.
/vendor/
composer.phar

# The development database. Rebuild it with:
#     php vayu migrate && php vayu seed
/database/database.sqlite

# Uploads and CVs. Never committed — a CV is a named person's phone
# number and employment history, and .gitkeep is enough to keep the
# directories in the tree. assets/uploads/ keeps its .htaccess: the rule
# that stops an upload being executed has to ship with the directory.
/storage/uploads/*
/storage/cv/*
# Fetched from Google and rebuilt on demand; nothing in here is authored.
/storage/cache/*
!/storage/**/.gitkeep
/assets/uploads/*
!/assets/uploads/.gitkeep
!/assets/uploads/.htaccess

# Logs and runtime files
/logs/
*.log
*.cache

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
/.vscode/
/.idea/

# Build and temporary files
*.tmp
*.temp
*.bak

# Worktrees and local agent state
/.claude/
